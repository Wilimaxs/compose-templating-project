<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TemplateCompose" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Use the Android system splash before switching to the regular Activity theme. -->
    <style name="Theme.TemplateCompose.Starting" parent="Theme.SplashScreen">
        <!-- TODO(template): Adjust the splash background color to suit your app branding. -->
        <item name="windowSplashScreenBackground">@color/purple_700</item>
        <!-- Display the imported vector logo as the system splash icon. -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_logo_fruit</item>
        <item name="postSplashScreenTheme">@style/Theme.TemplateCompose</item>
    </style>
</resources>
