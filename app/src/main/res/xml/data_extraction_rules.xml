<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Keep device-bound ciphertext out of cloud backups. -->
        <exclude domain="file" path="datastore/secure_state.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <!-- A transferred ciphertext cannot be decrypted by the new device's Keystore key. -->
        <exclude domain="file" path="datastore/secure_state.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
